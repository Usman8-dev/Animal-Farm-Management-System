# =========================================================================
# 📦 DEPENDENCIES & PACKAGES
# =========================================================================
# Ignores node_modules in both backend and frontend folders
**/node_modules/
**/jspm_packages/
**/web_modules/

# =========================================================================
# 🚀 BUILD & OUTPUTS (React / Vite / Next.js / Build Tools)
# =========================================================================
**/dist/
**/build/
**/out/
**/.next/
**/.nuxt/
**/public/build/
**/.cache/
**/.parcel-cache/

# =========================================================================
# 🔒 SECURITY & SECRETS (CRITICAL)
# =========================================================================
# Blocks all .env configuration files in both frontend and backend
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/.env.*.local

# =========================================================================
# 📝 LOGS & DEBUGGING
# =========================================================================
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# =========================================================================
# 🧪 TEST COVERAGE
# =========================================================================
**/coverage/
**/*.lcov
**/.nyc_output/

# =========================================================================
# 💻 IDE, EDITORS & SYSTEM FILES
# =========================================================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# =========================================================================
# ◭ PRISMA & LOCAL DATABASES
# =========================================================================
# Ignore local SQLite database files (if you are using SQLite)
**/*.db
**/*.db-journal

# Ignore local migrations log / schema files you don't want tracked
**/prisma/.env

# =========================================================================
# 🤖 AI TOOL CACHES & GENERATED CODE
# =========================================================================
# Ignores configuration and chat history from Windsurf, Claude, and Agents
**/.agents/
**/.claude/
**/.windsurf/
**/generated/
