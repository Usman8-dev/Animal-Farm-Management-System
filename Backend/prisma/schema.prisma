// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FarmRole {
  manager
  worker
}

enum MemberStatus {
  active
  pending
  removed
}

model Person {
  id           Int       @id @default(autoincrement())
  name         String
  cnic_number  String?   @unique
  gender       String
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  createdby    Int?
  updatedby    Int?
  deletedby    Int?

  createdByPerson Person? @relation("PersonCreatedBy", fields: [createdby], references: [id])
  updatedByPerson Person? @relation("PersonUpdatedBy", fields: [updatedby], references: [id])
  deletedByPerson Person? @relation("PersonDeletedBy", fields: [deletedby], references: [id])

  // reverse relations for self-references
  createdPersons Person[] @relation("PersonCreatedBy")
  updatedPersons Person[] @relation("PersonUpdatedBy")
  deletedPersons Person[] @relation("PersonDeletedBy")

  credentials      Person_Credentials?
  ownedFarm        Farms?  @relation("FarmOwner")
  farmMember       Farm_Members[] @relation("FarmMemberPerson")

  @@map("person")
}

model Person_Credentials {
  id             Int       @id @default(autoincrement())
  person_id      Int       @unique
  person         Person    @relation(fields: [person_id], references: [id])

  email          String    @unique
  password       String
  email_verified Boolean   @default(false)

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  createdby      Int?
  updatedby      Int?
  deletedby      Int?

  @@map("person_credentials")
}

model Farms {
  id         Int       @id @default(autoincrement())
  farm_name  String
  owner_id   Int       @unique
  owner      Person    @relation("FarmOwner", fields: [owner_id], references: [id])
  location   String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  createdby  Int?
  updatedby  Int?
  deletedby  Int?

  members     Farm_Members[]
  animals     Animal[] 
  genders     Gender[]
  animalTypes AnimalType[]
  breeds      Breed[]
  animalStatus      AnimalStatus[]

  @@map("farms")
}


model Farm_Members {
  id         Int          @id @default(autoincrement())
  farm_id    Int
  farm       Farms        @relation(fields: [farm_id], references: [id])

  person_id  Int
  person     Person       @relation("FarmMemberPerson", fields: [person_id], references: [id])

  role       FarmRole
  status     MemberStatus @default(active)
  joined_at  DateTime     @default(now())

  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  deleted_at DateTime?

  createdby  Int?
  updatedby  Int?
  deletedby  Int?

  @@map("farm_members")
}

enum AcquisitionType {
  BORN_IN_FARM
  PURCHASED
}

// ── Reference / Lookup Data ─────────────────────────────────

model Gender {
  id      Int      @id @default(autoincrement())
  farm_id Int
  farm    Farms    @relation(fields: [farm_id], references: [id])
  code    String
  name    String

  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  deleted_at DateTime?

  createdby  Int?
  updatedby  Int?
  deletedby  Int?

  animals Animal[]

  @@unique([farm_id, code])
  @@map("genders")
}

model AnimalType {
  id         Int       @id @default(autoincrement())
  farm_id    Int
  farm       Farms     @relation(fields: [farm_id], references: [id])
  code       String
  name       String
  is_active  Boolean   @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  createdby  Int?
  updatedby  Int?
  deletedby  Int?

  breeds     Breed[]
  animals    Animal[]

  @@unique([farm_id, code])
  @@map("animal_types")
}

model Breed {
  id              Int         @id @default(autoincrement())
  farm_id         Int
  farm            Farms       @relation(fields: [farm_id], references: [id])
  animal_type_id  Int
  animalType      AnimalType  @relation(fields: [animal_type_id], references: [id])

  code            String
  name            String
  gestation_days  Int         // used to calculate Pregnancies.expected_delivery_date (Module 4)
  maturity_days   Int         // age (days) at which the animal is breeding-eligible
  is_active       Boolean     @default(true)

  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  deleted_at DateTime?

  createdby  Int?
  updatedby  Int?
  deletedby  Int?

  animals         Animal[]

  @@unique([farm_id, animal_type_id, code])
  @@map("breeds")
}

// ── Core Animal Record ──────────────────────────────────────

model Animal {
  id                Int             @id @default(autoincrement())

  // Every animal belongs to exactly one farm (multi-tenancy boundary)
  farm_id           Int
  farm              Farms           @relation(fields: [farm_id], references: [id])

  tag_number        String
  name              String?

  animal_type_id    Int
  animalType        AnimalType      @relation(fields: [animal_type_id], references: [id])

  breed_id          Int
  breed             Breed           @relation(fields: [breed_id], references: [id])

  gender_id         Int
  gender            Gender          @relation(fields: [gender_id], references: [id])

  birth_date        DateTime?

  // Self-referencing lineage — NULL when acquisition_type = PURCHASED
  // (see Business Rule 2 below)
  mother_id         Int?
  mother            Animal?         @relation("AnimalMother", fields: [mother_id], references: [id])
  motherOf          Animal[]        @relation("AnimalMother")

  father_id         Int?
  father            Animal?         @relation("AnimalFather", fields: [father_id], references: [id])
  fatherOf          Animal[]        @relation("AnimalFather")

  acquisition_type  AcquisitionType
  acquired_on       DateTime?
  notes             String?

  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  deleted_at        DateTime?

  createdby         Int?
  updatedby         Int?
  deletedby         Int?

  images            AnimalImage[]
  statusHistory      StatusHistory[]
  weightHistory   WeightHistory[]
  valuations      AnimalValuation[]

  @@unique([farm_id, tag_number]) // tag numbers are unique per farm, not globally
  @@map("animals")
}

model AnimalImage {
  id         Int      @id @default(autoincrement())
  animal_id  Int
  animal     Animal   @relation(fields: [animal_id], references: [id])

  url        String
  caption    String?
  is_primary Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime     @updatedAt
  deleted_at DateTime?

  createdby  Int?
  updatedby  Int?
  deletedby  Int?

  @@map("animal_images")
}


//----------------------------- Module 2 -------------------------

enum StatusCategory {
  PRESENCE
  REPRODUCTIVE
  HEALTH
}
model AnimalStatus {
  id         Int             @id @default(autoincrement())
  farm_id    Int
  farm       Farms           @relation(fields: [farm_id], references: [id])

  code       String          // short label, e.g. "ACTIVE", "SICK" — display only
  name       String          // e.g. "Active", "Sick"
  category   StatusCategory  // fixed grouping the backend reasons about

  is_active  Boolean         @default(true)

  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  deleted_at DateTime?

  createdby  Int?
  updatedby  Int?
  deletedby  Int?

  history    StatusHistory[]

  @@unique([farm_id, code])
  @@map("animal_statuses")
}

model StatusHistory {
  id             Int          @id @default(autoincrement())

  animal_id      Int
  animal         Animal       @relation(fields: [animal_id], references: [id])

  status_id      Int
  status         AnimalStatus @relation(fields: [status_id], references: [id])

  effective_from DateTime     @default(now())
  effective_to   DateTime?    // NULL = this is the animal's current/open status
  reason         String?

  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  deleted_at     DateTime?

  createdby      Int?
  updatedby      Int?
  deletedby      Int?

  @@map("status_history")
}


// ── Module 3: Weight & Valuation ─────────────────────────────

model WeightHistory {
  id             Int       @id @default(autoincrement())
  animal_id      Int
  animal         Animal    @relation(fields: [animal_id], references: [id])

  weight_kg      Decimal   @db.Decimal(10, 2)
  effective_from DateTime  @default(now())
  effective_to   DateTime?
  source         String?
  notes          String?

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?
  createdby      Int?
  updatedby      Int?
  deletedby      Int?

  @@index([animal_id, effective_from])
  @@map("weight_history")
}

model AnimalValuation {
  id             Int       @id @default(autoincrement())
  animal_id      Int
  animal         Animal    @relation(fields: [animal_id], references: [id])

  value_amount   Decimal   @db.Decimal(14, 2)
  basis          String?
  effective_from DateTime  @default(now())
  effective_to   DateTime?
  notes          String?

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?
  createdby      Int?
  updatedby      Int?
  deletedby      Int?

  @@index([animal_id, effective_from])
  @@map("animal_valuations")
}