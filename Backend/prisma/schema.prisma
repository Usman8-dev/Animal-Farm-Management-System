// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FarmRole {
  manager
  worker
}

enum MemberStatus {
  active
  pending
  removed
}

model Person {
  id           Int       @id @default(autoincrement())
  name         String
  cnic_number  String?   @unique
  gender       String
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  createdby    Int?
  updatedby    Int?
  deletedby    Int?

  createdByPerson Person? @relation("PersonCreatedBy", fields: [createdby], references: [id])
  updatedByPerson Person? @relation("PersonUpdatedBy", fields: [updatedby], references: [id])
  deletedByPerson Person? @relation("PersonDeletedBy", fields: [deletedby], references: [id])

  // reverse relations for self-references
  createdPersons Person[] @relation("PersonCreatedBy")
  updatedPersons Person[] @relation("PersonUpdatedBy")
  deletedPersons Person[] @relation("PersonDeletedBy")

  credentials      Person_Credentials?
  ownedFarm        Farms?  @relation("FarmOwner")
  farmMember       Farm_Members[] @relation("FarmMemberPerson")

  @@map("person")
}

model Person_Credentials {
  id             Int       @id @default(autoincrement())
  person_id      Int       @unique
  person         Person    @relation(fields: [person_id], references: [id])

  email          String    @unique
  password       String
  email_verified Boolean   @default(false)

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  createdby      Int?
  updatedby      Int?
  deletedby      Int?

  @@map("person_credentials")
}

model Farms {
  id         Int       @id @default(autoincrement())
  farm_name  String
  owner_id   Int       @unique
  owner      Person    @relation("FarmOwner", fields: [owner_id], references: [id])
  location   String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  createdby  Int?
  updatedby  Int?
  deletedby  Int?

  members     Farm_Members[]
  animals     Animal[] 
  genders     Gender[]
  animalTypes AnimalType[]
  breeds      Breed[]
  animalStatus      AnimalStatus[]
  pregnancies Pregnancy[]

  vaccinationTypes          VaccinationType[]
  vaccinationScheduleRules  VaccinationScheduleRule[]
  animalVaccinations        AnimalVaccination[]

  @@map("farms")
}


model Farm_Members {
  id         Int          @id @default(autoincrement())
  farm_id    Int
  farm       Farms        @relation(fields: [farm_id], references: [id])

  person_id  Int
  person     Person       @relation("FarmMemberPerson", fields: [person_id], references: [id])

  role       FarmRole
  status     MemberStatus @default(active)
  joined_at  DateTime     @default(now())

  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  deleted_at DateTime?

  createdby  Int?
  updatedby  Int?
  deletedby  Int?

  @@map("farm_members")
}

enum AcquisitionType {
  BORN_IN_FARM
  PURCHASED
}

// ── Reference / Lookup Data ─────────────────────────────────

model Gender {
  id      Int      @id @default(autoincrement())
  farm_id Int
  farm    Farms    @relation(fields: [farm_id], references: [id])
  code    String
  name    String

  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  deleted_at DateTime?

  createdby  Int?
  updatedby  Int?
  deletedby  Int?

  animals Animal[]

  @@unique([farm_id, code])
  @@map("genders")
}

model AnimalType {
  id         Int       @id @default(autoincrement())
  farm_id    Int
  farm       Farms     @relation(fields: [farm_id], references: [id])
  code       String
  name       String
  is_active  Boolean   @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  createdby  Int?
  updatedby  Int?
  deletedby  Int?

  breeds     Breed[]
  animals    Animal[]

  vaccinationScheduleRules VaccinationScheduleRule[]

  @@unique([farm_id, code])
  @@map("animal_types")
}

model Breed {
  id              Int         @id @default(autoincrement())
  farm_id         Int
  farm            Farms       @relation(fields: [farm_id], references: [id])
  animal_type_id  Int
  animalType      AnimalType  @relation(fields: [animal_type_id], references: [id])

  code            String
  name            String
  gestation_days  Int         // used to calculate Pregnancies.expected_delivery_date (Module 4)
  maturity_days   Int         // age (days) at which the animal is breeding-eligible
  is_active       Boolean     @default(true)

  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  deleted_at DateTime?

  createdby  Int?
  updatedby  Int?
  deletedby  Int?

  animals         Animal[]

  @@unique([farm_id, animal_type_id, code])
  @@map("breeds")
}

// ── Core Animal Record ──────────────────────────────────────

model Animal {
  id                Int             @id @default(autoincrement())

  // Every animal belongs to exactly one farm (multi-tenancy boundary)
  farm_id           Int
  farm              Farms           @relation(fields: [farm_id], references: [id])

  tag_number        String
  name              String?

  animal_type_id    Int
  animalType        AnimalType      @relation(fields: [animal_type_id], references: [id])

  breed_id          Int
  breed             Breed           @relation(fields: [breed_id], references: [id])

  gender_id         Int
  gender            Gender          @relation(fields: [gender_id], references: [id])

  birth_date        DateTime?

  // Self-referencing lineage — NULL when acquisition_type = PURCHASED
  // (see Business Rule 2 below)
  mother_id         Int?
  mother            Animal?         @relation("AnimalMother", fields: [mother_id], references: [id])
  motherOf          Animal[]        @relation("AnimalMother")

  father_id         Int?
  father            Animal?         @relation("AnimalFather", fields: [father_id], references: [id])
  fatherOf          Animal[]        @relation("AnimalFather")

  acquisition_type  AcquisitionType
  acquired_on       DateTime?
  notes             String?

  // Marks this animal as an active breeder (used by breeding workflows)
  breeder           Boolean         @default(false)

  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  deleted_at        DateTime?

  createdby         Int?
  updatedby         Int?
  deletedby         Int?

  images            AnimalImage[]
  statusHistory      StatusHistory[]
  weightHistory   WeightHistory[]
  valuations      AnimalValuation[]

  pregnancyDams   Pregnancy[] @relation("PregnancyDam")
  pregnancySires  Pregnancy[] @relation("PregnancySire")
  birthKids       BirthKid[]
  vaccinations    AnimalVaccination[]

  @@unique([farm_id, tag_number]) // tag numbers are unique per farm, not globally
  @@map("animals")
}

model AnimalImage {
  id         Int      @id @default(autoincrement())
  animal_id  Int
  animal     Animal   @relation(fields: [animal_id], references: [id])

  url        String
  caption    String?
  is_primary Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime     @updatedAt
  deleted_at DateTime?

  createdby  Int?
  updatedby  Int?
  deletedby  Int?

  @@map("animal_images")
}


//----------------------------- Module 2 -------------------------

enum StatusCategory {
  PRESENCE
  REPRODUCTIVE
  HEALTH
}
model AnimalStatus {
  id         Int             @id @default(autoincrement())
  farm_id    Int
  farm       Farms           @relation(fields: [farm_id], references: [id])

  code       String          // short label, e.g. "ACTIVE", "SICK" — display only
  name       String          // e.g. "Active", "Sick"
  category   StatusCategory  // fixed grouping the backend reasons about

  is_active  Boolean         @default(true)

  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  deleted_at DateTime?

  createdby  Int?
  updatedby  Int?
  deletedby  Int?

  history    StatusHistory[]

  @@unique([farm_id, code])
  @@map("animal_statuses")
}

model StatusHistory {
  id             Int          @id @default(autoincrement())

  animal_id      Int
  animal         Animal       @relation(fields: [animal_id], references: [id])

  status_id      Int
  status         AnimalStatus @relation(fields: [status_id], references: [id])

  effective_from DateTime     @default(now())
  effective_to   DateTime?    // NULL = this is the animal's current/open status
  reason         String?

  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  deleted_at     DateTime?

  createdby      Int?
  updatedby      Int?
  deletedby      Int?

  @@map("status_history")
}


// ── Module 3: Weight & Valuation ─────────────────────────────

model WeightHistory {
  id             Int       @id @default(autoincrement())
  animal_id      Int
  animal         Animal    @relation(fields: [animal_id], references: [id])

  weight_kg      Decimal   @db.Decimal(10, 2)
  effective_from DateTime  @default(now())
  effective_to   DateTime?
  source         String?
  notes          String?

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?
  createdby      Int?
  updatedby      Int?
  deletedby      Int?

  @@index([animal_id, effective_from])
  @@map("weight_history")
}

model AnimalValuation {
  id             Int       @id @default(autoincrement())
  animal_id      Int
  animal         Animal    @relation(fields: [animal_id], references: [id])

  value_amount   Decimal   @db.Decimal(14, 2)
  basis          String?
  effective_from DateTime  @default(now())
  effective_to   DateTime?
  notes          String?

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?
  createdby      Int?
  updatedby      Int?
  deletedby      Int?

  @@index([animal_id, effective_from])
  @@map("animal_valuations")
}

// ── Module 4: Breeding & Reproduction Management ──────────────

enum PregnancyOutcome {
  LIVE_BIRTH
  STILLBIRTH
  ABORTED
  NOT_PREGNANT
}

model Pregnancy {
  id                     Int              @id @default(autoincrement())

  // Multi-tenancy: a pregnancy belongs to the farm of its dam
  farm_id                Int
  farm                   Farms            @relation(fields: [farm_id], references: [id])

  // The female being bred (dam) — always required
  dam_id                Int
  dam                  Animal           @relation("PregnancyDam", fields: [dam_id], references: [id])

  // The male (sire). Either a registered animal (sire_id) or a free-text
  // reference (sire_ref) for external / AI semen when sire_id is null.
  sire_id               Int?
  sire                  Animal?          @relation("PregnancySire", fields: [sire_id], references: [id])
  sire_ref              String?

  service_date          DateTime         // the mating / service event (conception estimate)
  expected_delivery_date DateTime        // service_date + Breeds.gestation_days (computed on create)

  is_confirmed          Boolean          @default(false)
  confirmed_date        DateTime?

  outcome               PregnancyOutcome? // NULL while the pregnancy is still open
  outcome_date          DateTime?

  notes                 String?

  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
  deleted_at            DateTime?
  createdby             Int?
  updatedby             Int?
  deletedby             Int?

  birth                 Birth?

  @@index([farm_id, expected_delivery_date])
  @@index([dam_id, service_date])
  @@map("pregnancies")
}

model Birth {
  id            Int       @id @default(autoincrement())
  pregnancy_id  Int       @unique
  pregnancy     Pregnancy @relation(fields: [pregnancy_id], references: [id])

  birth_date    DateTime
  notes         String?

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  createdby     Int?
  updatedby     Int?
  deletedby     Int?

  kids          BirthKid[]

  @@map("births")
}

model BirthKid {
  id              Int       @id @default(autoincrement())
  birth_id        Int
  birth           Birth     @relation(fields: [birth_id], references: [id])

  // Set when the offspring is auto-registered as a new farm animal.
  animal_id       Int?      @unique
  animal          Animal?   @relation(fields: [animal_id], references: [id])

  is_stillborn    Boolean   @default(false)
  gender          String?   // free text (e.g. "Female") — real type lives on the registered animal
  birth_weight_kg Decimal?  @db.Decimal(10, 2)
  notes           String?

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?
  createdby       Int?
  updatedby       Int?
  deletedby       Int?

  @@map("birth_kids")
}

// ── Module 5: Vaccination & Immunization Management ────────────

model VaccinationType {
  id          Int       @id @default(autoincrement())
  farm_id     Int
  farm        Farms     @relation(fields: [farm_id], references: [id])

  code        String
  name        String
  description String?
  is_active   Boolean   @default(true)

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  createdby   Int?
  updatedby   Int?
  deletedby   Int?

  scheduleRules      VaccinationScheduleRule[]
  animalVaccinations AnimalVaccination[]

  @@unique([farm_id, code])
  @@map("vaccination_types")
}

model VaccinationScheduleRule {
  id                  Int             @id @default(autoincrement())
  farm_id             Int
  farm                Farms           @relation(fields: [farm_id], references: [id])

  vaccination_type_id Int
  vaccinationType     VaccinationType @relation(fields: [vaccination_type_id], references: [id])

  animal_type_id      Int
  animalType          AnimalType      @relation(fields: [animal_type_id], references: [id])

  dose_number         Int             // which dose in the series (1, 2, 3…)
  age_days            Int             // age (days) at which this dose is due
  notes               String?

  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  deleted_at          DateTime?
  createdby           Int?
  updatedby           Int?
  deletedby           Int?

  @@unique([farm_id, vaccination_type_id, animal_type_id, dose_number])
  @@index([animal_type_id])
  @@map("vaccination_schedule_rules")
}

model AnimalVaccination {
  id                  Int             @id @default(autoincrement())
  farm_id             Int
  farm                Farms           @relation(fields: [farm_id], references: [id])

  animal_id           Int
  animal              Animal          @relation(fields: [animal_id], references: [id])

  vaccination_type_id Int
  vaccinationType     VaccinationType @relation(fields: [vaccination_type_id], references: [id])

  category            String          @default("NORMAL") // NORMAL | SEASONAL

  administered_date   DateTime        @default(now())
  dose_number         Int?            // which dose in the series this record represents
  batch_number        String?         // used for batch/recall tracking
  administered_by     String?
  cost                Decimal?        @db.Decimal(12, 2)
  next_due_date       DateTime?       // due date entered by the user on the record
  notes               String?

  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  deleted_at          DateTime?
  createdby           Int?
  updatedby           Int?
  deletedby           Int?

  @@index([animal_id, administered_date])
  @@index([vaccination_type_id, batch_number])
  @@map("animal_vaccinations")
}